# ---------------------------------------------------------------
# UNLOAD — environment variables
#
# Copy this file to `.env` and fill in what you need.
#   cp .env.example .env
#
# UNLOAD works fully WITHOUT any key. With no key configured the
# app uses its built-in deterministic local organiser, and the UI
# shows a "Local mode" badge. Nothing breaks.
# ---------------------------------------------------------------

# Which LLM provider the backend should use.
# Options: anthropic | openai | local
# "local" (or leaving this blank with no key set) = offline fallback.
AI_PROVIDER=local

# --- Anthropic (recommended) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI (alternative) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Port for the local AI proxy server.
# The Vite dev server proxies /api -> http://localhost:PORT
PORT=8787
